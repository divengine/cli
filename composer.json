{
    "name": "divengine/cli",
    "description": "Div CLI - Official runtime and package manager for the Divengine ecosystem",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "divengine/div": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "divengine\\": "src/"
        }
    },
    "bin": [
        "bin/div"
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit",
        "build:phar": "php build/build-phar.php"
    }
}
